{
  "name": "@yaegassy/coc-vitest",
  "version": "0.3.0",
  "description": "Vitest for coc.nvim",
  "author": "yaegassy <yosstools@gmail.com>",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "README.md"
  ],
  "keywords": [
    "coc.nvim",
    "vitest",
    "typescript",
    "javascript",
    "typescriptreact",
    "javascriptreact",
    "vim",
    "neovim"
  ],
  "engines": {
    "coc": "^0.0.80"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yaegassy/coc-vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "watch": "rolldown -c --watch",
    "build": "rolldown -c",
    "prepare": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.43",
    "coc.nvim": "0.0.83-next.27",
    "jest-editor-support": "^31.1.2",
    "rolldown": "^1.2.13",
    "typescript": "~7.0.2"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "coc-vitest configuration",
      "properties": {
        "vitest.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable coc-vitest extension."
        },
        "vitest.terminal.enableSplitRight": {
          "type": "boolean",
          "default": false,
          "description": "Use vertical belowright for vitest terminal window."
        },
        "vitest.codelens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable codelens."
        },
        "vitest.codelens.title": {
          "type": "string",
          "default": ">> [Run Vitest]",
          "description": "CodeLens title. Can be changed to any display."
        },
        "vitest.watch": {
          "type": "boolean",
          "default": false,
          "description": "Run tests in watch mode"
        }
      }
    },
    "commands": [
      {
        "command": "vitest.projectTest",
        "title": "Run Vitest for current project"
      },
      {
        "command": "vitest.fileTest",
        "title": "Run Vitest for current file"
      },
      {
        "command": "vitest.singleTest",
        "title": "Run Vitest for single (nearest) test"
      }
    ]
  }
}
